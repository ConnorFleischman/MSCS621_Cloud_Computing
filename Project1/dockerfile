FROM golang:1.22-alpine

WORKDIR /app

# Download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Build the same news CLI used by the Windows executable.
COPY models/ ./models/
COPY tests/newsapi/*.go ./tests/newsapi/
COPY tests/cmd/newsapi_cli/*.go ./tests/cmd/newsapi_cli/
RUN go build -o newscli ./tests/cmd/newsapi_cli

# Pass container arguments directly to the CLI.
ENTRYPOINT ["./newscli"]
